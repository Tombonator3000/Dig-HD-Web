+// Some icon sheets were cut with the original hard mask after being painted
+// against a blue matte. At the edge, the mask can include the painted matte.
+// Repair only near-transparent edge pixels close to that matte whose original
+// palette colour is different. Intentional blue selections and interiors stay.
+static void repairBlastEdges(Graphics::Surface &hd, const Graphics::Surface &idx,
+                             int transparent, const byte *basePal,
+                             const Graphics::PixelFormat &rgba, int scale) {
+	if (transparent < 0 || idx.w > 32 || idx.h > 24 || hd.w != idx.w * scale || hd.h != idx.h * scale)
+		return;
+	uint counts[4096] = {};
+	uint hidden = 0, most = 0;
+	int bucket = 0;
+	for (int y = 0; y < hd.h; y++) {
+		const uint32 *row = (const uint32 *)hd.getBasePtr(0, y);
+		for (int x = 0; x < hd.w; x++) {
+			byte a, r, g, b;
+			rgba.colorToARGB(row[x], a, r, g, b);
+			if (a)
+				continue;
+			const int k = ((r >> 4) << 8) | ((g >> 4) << 4) | (b >> 4);
+			if (++counts[k] > most) {
+				most = counts[k];
+				bucket = k;
+			}
+			hidden++;
+		}
+	}
+	if (!hidden || most * 2 < hidden)
+		return;  // no flat, unambiguous matte
+	const int key[3] = { ((bucket >> 8) & 15) * 16 + 8,
+	                     ((bucket >> 4) & 15) * 16 + 8, (bucket & 15) * 16 + 8 };
+	Graphics::Surface original;
+	original.copyFrom(hd);
+	for (int y = 0; y < hd.h; y++) {
+		for (int x = 0; x < hd.w; x++) {
+			byte a, r, g, b;
+			rgba.colorToARGB(*(const uint32 *)original.getBasePtr(x, y), a, r, g, b);
+			if (a != 255 || MAX(ABS((int)r - key[0]), MAX(ABS((int)g - key[1]), ABS((int)b - key[2]))) > 48)
+				continue;
+			const byte code = *(const byte *)idx.getBasePtr(x / scale, y / scale);
+			const byte *base = basePal + code * 3;
+			if (MAX(ABS((int)base[0] - key[0]), MAX(ABS((int)base[1] - key[1]), ABS((int)base[2] - key[2]))) < 96)
+				continue;  // the original deliberately uses the matte colour
+			bool edge = false;
+			int best = 0x7FFFFFFF;
+			uint32 colour = rgba.ARGBToColor(255, base[0], base[1], base[2]);
+			for (int yy = MAX(0, y - scale); yy <= MIN(hd.h - 1, y + scale); yy++) {
+				for (int xx = MAX(0, x - scale); xx <= MIN(hd.w - 1, x + scale); xx++) {
+					byte na, nr, ng, nb;
+					const uint32 value = *(const uint32 *)original.getBasePtr(xx, yy);
+					rgba.colorToARGB(value, na, nr, ng, nb);
+					edge |= na == 0;
+					if (na != 255 || *(const byte *)idx.getBasePtr(xx / scale, yy / scale) != code ||
+					    MAX(ABS((int)nr - key[0]), MAX(ABS((int)ng - key[1]), ABS((int)nb - key[2]))) < 96)
+						continue;
+					const int distance = (xx - x) * (xx - x) + (yy - y) * (yy - y);
+					if (distance < best) {
+						best = distance;
+						colour = value;
+					}
+				}
+			}
+			if (edge)
+				*(uint32 *)hd.getBasePtr(x, y) = colour;
+		}
+	}
+	original.free();
+}
