+		// padY original pixels on each side, and its own alpha (see drawSoftCels())
+		bool soft = false;
+		int padX = 0, padY = 0;
+		Common::Array<byte> nearCycle;  // per original pixel: cycles or touches a cycled pixel
+		uint32 nearCycleGen = 0;        // _cycledGen the mask was made for
