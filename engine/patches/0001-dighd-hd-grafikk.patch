+/*
+ * Dig HD: HD replacement graphics for The Dig.
+ *
+ * The engine keeps running in 320x200 with 256 colours. Every time a
+ * finished 8-bit area is sent to the screen, this class builds the same
+ * area at N times the resolution in full colour:
+ *
+ *  - pixels that still show the untouched room background are taken from
+ *    an HD room image (mods/<name>/rooms/roomNNN.png),
+ *  - pixels that show an object image (doors, machines) are taken from an
+ *    HD object image (mods/<name>/objects/objNNN_SS.png),
+ *  - pixels of a costume cel come from mods/<name>/costumes/costumeCCC_NNN.png,
+ *    as long as the pixel still holds the value the cel drew and nothing else
+ *    (a banner, a menu, a box) has been drawn there since,
+ *  - a costume cel with a free outline (costumeCCC_NNN_hd.png, with real
+ *    alpha and a margin around the cel) is laid over the HD picture with soft
+ *    edges, see drawSoftCels(),
+ *  - film frames come from mods/<name>/san/<FILE>/NNNNN.png, except the
+ *    pixels of text (subtitles) that SmushPlayer draws over the film,
+ *  - text (dialog, banners, menus, subtitles) is drawn with HD glyphs made
+ *    from the game's own fonts, over the HD picture that is under the text,
+ *  - everything else (effects) is the original pixel scaled up.
+ *
+ * Which pixels are "untouched background" is decided by comparing against
+ * the original 8-bit image shipped next to each HD image (*_idx.png). When
+ * the palette changes (fades, light switches), the HD pixel is tinted by the
+ * ratio between the current and the original colour. Where colours cycle
+ * (water, energy), that ratio is interpolated smoothly between the original
+ * pixels, so the HD image follows the cycling without a grid of blocks.
+ *
+ * While playing, Ctrl+H switches between HD and classic graphics (the
+ * original pixels scaled up, same screen size) and Ctrl+Shift+H puts a
+ * yellow tint on pixels that are shown as original pixels because no HD
+ * image exists for them.
+ */
+
+#ifndef SCUMM_DIGHD_H
+#define SCUMM_DIGHD_H
+
+#include "common/array.h"
+#include "common/hashmap.h"
+#include "common/keyboard.h"
+#include "common/path.h"
+#include "common/rect.h"
+#include "common/str.h"
+#include "graphics/pixelformat.h"
+#include "graphics/surface.h"
+
+namespace Scumm {
+
+class ScummEngine;
+struct VirtScreen;
+
+class DigHD {
+public:
+	/** Returns nullptr unless HD mode is requested (DIGHD_MOD / dighd_mod). */
+	static DigHD *create(ScummEngine *vm);
+	~DigHD();
+
+	int scale() const { return _scale; }
+
+	/** Replaces initGraphics() for the game screen. */
+	bool initGraphics(int width, int height);
+
+	/** Final blit of a virtual screen area (front buffer), see drawStripToScreen(). */
+	void blitVirtScreen(VirtScreen *vs, const byte *src, int pitch, int x, int y, int top, int width, int height);
+	/** Plain 8-bit blit without any HD lookup (effects, menus). */
+	void blit8(const byte *src, int pitch, int x, int y, int width, int height);
+	/** SMUSH frame blit; uses mods/<name>/san/<FILE>/<frame>.png when present. */
+	void blitSmush(const byte *src, int pitch, int width, int height, const Common::String &file, int frame);
+
+	/**
+	 * Text over SMUSH frames (subtitles). SmushPlayer draws text straight into
+	 * its 8-bit frame buffer. The same text is also drawn into the layer from
+	 * smushTextBegin(), which holds the frame with every byte inverted; after
+	 * both draws, the pixels where layer and frame are equal are exactly the
+	 * pixels the text wrote. These stay original pixels over an HD frame.
+	 */
+	byte *smushTextBegin(const byte *frame, int pitch, int height);
+	void smushTextEnd(const byte *frame);
+	/** A new picture was decoded into the SMUSH frame buffer: no text on it yet. */
+	void smushClearText();
+
+	/**
+	 * Text in HD (dialog, banners, menus, film subtitles). The glyph renderers
+	 * call noteGlyph() right before a glyph is drawn into an 8-bit buffer. The
+	 * glyph is remembered per buffer pixel; when the buffer is shown, a pixel
+	 * that still holds the value the glyph wrote shows the HD glyph, made once
+	 * per glyph shape from the game's own font image (see makeGlyphHD()).
+	 */
+	struct GlyphDraw {
+		const byte *buffer;  // the buffer the renderer draws into
+		int pitch;
+		int x, y;            // top left of the glyph, relative to buffer
+		int w, h;            // glyph size
+		const byte *values;  // w * h raw glyph values
+		int transparent;     // raw value that is not drawn
+		const byte *map;     // palette index written for each raw value (256 entries)
+		int x0, y0, x1, y1;  // the part that is drawn, in glyph coordinates
+		int font = -1;       // which font: the charset number, or 100 + n for FONTn.NUT
+		int chr = -1;        // character code
+	};
+	void noteGlyph(const GlyphDraw &g);
+	/** The texts of the game screen are removed (start of each frame, removeBlastTexts()). */
+	void clearText();
+	/**
+	 * Something is drawn into this part of the game screen (markRectAsDirty(),
+	 * screen x, virtscreen y, right and bottom exclusive for the figures).
+	 * dirtybit is the actor number when an actor marks the rectangle it draws.
+	 */
+	void dirtyRect(int left, int right, int top, int bottom, int dirtybit);
+	/**
+	 * The engine saves the game screen before it draws a banner over it, and
+	 * puts it back when the banner goes (showBannerAndPause(), clearBanner()).
