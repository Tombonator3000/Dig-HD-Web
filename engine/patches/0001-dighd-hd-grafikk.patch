+
+	struct DrawnObject {
+		int obj, state, x, y;
+		Image *image;
+		uint32 seq;
+	};
+
+	bool loadImage(const Common::Path &hdFile, const Common::Path &idxFile, int origW, int origH, Image &out, bool pad = false);
