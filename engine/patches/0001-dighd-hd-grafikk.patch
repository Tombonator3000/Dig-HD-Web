+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ *
+ */
+
+/*
+ * Dig HD: HD replacement graphics for The Dig.
+ *
+ * The engine keeps running in 320x200 with 256 colours. Every time a
+ * finished 8-bit area is sent to the screen, this class builds the same
+ * area at N times the resolution in full colour:
+ *
+ *  - pixels that still show the untouched room background are taken from
+ *    an HD room image (mods/<name>/rooms/roomNNN.png),
+ *  - pixels that show an object image (doors, machines) are taken from an
+ *    HD object image (mods/<name>/objects/objNNN_SS.png),
+ *  - pixels of a costume cel come from mods/<name>/costumes/costumeCCC_NNN.png,
+ *    as long as the pixel still holds the value the cel drew and nothing else
+ *    (a banner, a menu, a box) has been drawn there since,
+ *  - a costume cel with a free outline (costumeCCC_NNN_hd.png, with real
+ *    alpha and a margin around the cel) is laid over the HD picture with soft
+ *    edges, see drawSoftCels(),
+ *  - film frames come from mods/<name>/san/<FILE>/NNNNN.png, except the
+ *    pixels of text (subtitles) that SmushPlayer draws over the film,
+ *  - text (dialog, banners, menus, subtitles) is drawn with HD glyphs made
+ *    from the game's own fonts, over the HD picture that is under the text,
+ *  - everything else (effects) is the original pixel scaled up.
+ *
+ * Which pixels are "untouched background" is decided by comparing against
+ * the original 8-bit image shipped next to each HD image (*_idx.png). When
+ * the palette changes (fades, light switches), the HD pixel is tinted by the
+ * ratio between the current and the original colour. Where colours cycle
+ * (water, energy), that ratio is interpolated smoothly between the original
+ * pixels, so the HD image follows the cycling without a grid of blocks.
+ *
+ * While playing, Ctrl+H switches between HD and classic graphics (the
+ * original pixels scaled up, same screen size) and Ctrl+Shift+H puts a
+ * yellow tint on pixels that are shown as original pixels because no HD
+ * image exists for them.
+ *
+ * What is shown without an HD image (costume cels, object images, room
+ * backgrounds, film frames) is written to dighd-uten-hd.txt in the save
+ * folder, one line per image and room, so normal play gives the list of
+ * what is still missing (see noteMissing(); DIGHD_MANGLER=0 turns it off).
+ */
+
+#ifndef SCUMM_DIGHD_H
+#define SCUMM_DIGHD_H
+
+#include "common/array.h"
+#include "common/hashmap.h"
+#include "common/keyboard.h"
+#include "common/path.h"
+#include "common/rect.h"
+#include "common/str.h"
+#include "graphics/pixelformat.h"
+#include "graphics/surface.h"
+
+namespace Scumm {
+
+class ScummEngine;
+struct VirtScreen;
+
+class DigHD {
+public:
+	/** Returns nullptr unless HD mode is requested (DIGHD_MOD / dighd_mod). */
+	static DigHD *create(ScummEngine *vm);
+	~DigHD();
+
+	int scale() const { return _scale; }
+
+	/** Replaces initGraphics() for the game screen. */
+	bool initGraphics(int width, int height);
+
+	/**
+	 * Final blit of a virtual screen area (front buffer), see drawStripToScreen().
+	 * vsSrc: in SCUMM v6 src is a composed copy with the text layer; vsSrc is the
+	 * same area in the virtual screen buffer (for the per-pixel marks).
+	 */
+	void blitVirtScreen(VirtScreen *vs, const byte *src, int pitch, int x, int y, int top, int width, int height,
+	                    const byte *vsSrc = nullptr);
+	/** Plain 8-bit blit without any HD lookup (effects, menus). */
+	void blit8(const byte *src, int pitch, int x, int y, int width, int height);
+	/** SMUSH frame blit; uses mods/<name>/san/<FILE>/<frame>.png when present. */
+	void blitSmush(const byte *src, int pitch, int width, int height, const Common::String &file, int frame);
+
+	/**
+	 * Text over SMUSH frames (subtitles). SmushPlayer draws text straight into
+	 * its 8-bit frame buffer. The same text is also drawn into the layer from
+	 * smushTextBegin(), which holds the frame with every byte inverted; after
+	 * both draws, the pixels where layer and frame are equal are exactly the
+	 * pixels the text wrote. These stay original pixels over an HD frame.
+	 */
+	byte *smushTextBegin(const byte *frame, int pitch, int height);
+	void smushTextEnd(const byte *frame);
+	/** A new picture was decoded into the SMUSH frame buffer: no text on it yet. */
+	void smushClearText();
+
+	/**
+	 * Text in HD (dialog, banners, menus, film subtitles). The glyph renderers
+	 * call noteGlyph() right before a glyph is drawn into an 8-bit buffer. The
+	 * glyph is remembered per buffer pixel; when the buffer is shown, a pixel
+	 * that still holds the value the glyph wrote shows the HD glyph, made once
+	 * per glyph shape from the game's own font image (see makeGlyphHD()).
+	 */
+	struct GlyphDraw {
+		const byte *buffer;  // the buffer the renderer draws into
+		int pitch;
+		int x, y;            // top left of the glyph, relative to buffer
+		int w, h;            // glyph size
+		const byte *values;  // w * h raw glyph values
+		int transparent;     // raw value that is not drawn
+		const byte *map;     // palette index written for each raw value (256 entries)
+		int x0, y0, x1, y1;  // the part that is drawn, in glyph coordinates
+		int font = -1;       // which font: the charset number, or 100 + n for FONTn.NUT
+		int chr = -1;        // character code
+	};
+	void noteGlyph(const GlyphDraw &g);
+	/** The texts of the game screen are removed (start of each frame, removeBlastTexts()). */
+	void clearText();
+	/**
+	 * Something is drawn into this part of the game screen (markRectAsDirty(),
+	 * screen x, virtscreen y, right and bottom exclusive for the figures).
+	 * dirtybit is the actor number when an actor marks the rectangle it draws.
+	 */
+	void dirtyRect(int left, int right, int top, int bottom, int dirtybit);
+	/**
+	 * The engine saves the game screen before it draws a banner over it, and
+	 * puts it back when the banner goes (showBannerAndPause(), clearBanner()).
+	 * The figures under the banner are then the figures that were there.
+	 */
+	void screenSaved();
+	void screenRestored();
+	/** On while the engine draws text and marks it dirty; dirtyRect() then keeps the text. */
+	void setTextPass(bool on) { _textPass = on; }
+	// Sam & Max film noir mode: the HD picture is shown in gray (updatePalette())
+	void setNoir(bool on);
+	void grayOut(int count);
+	// Sam & Max, Car Bomb: a marker drawn with boxes, shown as one smooth glyph (finishBoxMarkers())
+	void noteBoxMarker(int x, int y, int w, int h);
+	void finishBoxMarkers();
+	/**
+	 * On while the engine marks a blast object it has drawn. Its transparent
+	 * pixels leave the figures under it, so dirtyRect() keeps the figures there;
+	 * the pixels it drew are told apart by their value (see markCel()).
+	 */
+	void setOverlayPass(bool on) { _overlayPass = on; }
+
+	void setPalette(const byte *colors, uint first, uint num);
+	void moveScreen(int dx, int dy, int height);
+	/** Object/state selected by setCursorFromImg; zero clears a buffer or builtin cursor. */
+	void noteCursorObject(int obj, int state);
+	void updateCursor(const byte *cursor, int width, int height, int hotspotX, int hotspotY, int transColor);
+	void noteObject(int obj, int state, int x, int y, int width, int height);
+
+	/**
+	 * Blast objects (drawn over the screen by scripts, such as the inventory):
+	 * beginBlast() keeps the pixels under the object before it is drawn,
+	 * endBlast() compares them with what was drawn. A pixel the object darkened
+	 * through the shadow palette (the see-through inventory box) is built in HD
+	 * from what is under it and tinted the same way; a pixel the object painted
+	 * gets the object's HD image (objects/objNNN_SS.png) when there is one.
+	 * blastsRemoved(): the engine took the blast objects away (each frame).
+	 */
+	void beginBlast(VirtScreen *vs, int x, int y, int width, int height, int obj, int state, int scaleX, int scaleY);
+	void endBlast(int obj, int state, int shadowMode, const byte *shadowPalette);
+	void blastsRemoved();
+
+	/**
+	 * An actor is about to be drawn (costume renderer), into the front buffer or
+	 * the back buffer. zbuf: the z-plane mask the renderer uses (0 = none).
+	 */
+	void beginActor(int actor, int costume, bool front, int zbuf);
+	/**
+	 * A costume cel was painted. Coordinates are in costume renderer space.
+	 * raw: the cel's codes were drawn as palette indices, without the actor
+	 * palette (codec 16 always, codec 5 when the script has not set the actor
+	 * palette). The shown colour then depends on the room palette.
+	 * precise: begin the cel before decoding, then capture actual writes with
+	 * recordCelPixel() instead of reconstructing ownership from the image.
+	 */
+	void noteCel(int cel, int left, int top, int width, int height, bool mirror, int xstart, bool raw, bool precise = false, int shadowMode = 0);
+	/** Byle RLE: called immediately after a real, unmasked pixel write. */
+	void recordCelPixel(const byte *dest, int sourceX, int sourceY, bool paletteMask = false, byte before = 0);
+
+	/** Called right before OSystem::updateScreen(); handles frame dumps and test hooks. */
+	void beforeUpdateScreen();
+
+	/**
+	 * Hotkeys while the game runs: Ctrl+H switches between HD and classic
+	 * graphics, Ctrl+Shift+H turns the yellow marking of missing HD on and off.
+	 * Returns true when the key was used here and must not reach the game.
+	 */
+	bool handleKey(const Common::KeyState &kbd, bool repeat);
+	/**
+	 * Called for every key press before anything else. Writes F keys, Esc and
+	 * H to the log (so a report from a real machine shows what arrived), and
+	 * gives F1 to F12 their usual ASCII codes when the backend left them out,
+	 * so F5 always opens the game's menu.
+	 */
+	void noteKey(Common::KeyState &kbd);
+	/**
+	 * A request to quit (Esc mapped to quit, window closed, Ctrl+Q, Alt+X or
+	 * Alt+Q) that did not come from the Quit button in the game's menu.
+	 * The Dig HD never quits straight to the desktop: the game's menu opens
+	 * instead, and quitting is done with its Quit button. Returns true when
+	 * the request was turned into the menu.
+	 */
+	bool interceptQuit(const char *source);
+	/**
+	 * Classic or HD graphics. The choice is saved as dighd_classic in the
+	 * game's settings and used at the next start. quiet: no message on the
+	 * screen (the game's own menu shows the choice as a checkbox).
+	 */
+	void setClassic(bool on, bool quiet = false);
+	bool classic() const { return _classic; }
+	void setShowMissing(bool on);
+
+private:
+	explicit DigHD(ScummEngine *vm);
+
+	struct Image {
+		Graphics::Surface hd;   // RGBA32, scale x original
+		Graphics::Surface idx;  // CLUT8, original size
+		byte basePal[768];
+		Common::Array<byte> opacity; // optional per-pixel SMAP drawing coverage
+		bool visibleAt(int x, int y) const {
+			return opacity.empty() ? (int)*((const byte *)idx.getBasePtr(x, y)) != transparent : opacity[y * idx.w + x] != 0;
+		}
+		int transparent = -1;
+		// A soft cel (costumeCCC_NNN_hd.png): the HD image has a margin of padX and
+		// padY original pixels on each side, and its own alpha (see drawSoftCels())
+		bool soft = false;
+		int padX = 0, padY = 0;
+		Common::Array<byte> nearCycle;  // per original pixel: cycles or touches a cycled pixel
+		uint32 nearCycleGen = 0;        // _cycledGen the mask was made for
+		bool valid() const { return hd.getPixels() && idx.getPixels(); }
+		void free();
+	};
+
+	struct CelSlot {
+		bool used = false;
+		int costume = 0, cel = 0;
+		Image *image = nullptr;
+		int rx = 0, ry = 0, rw = 0, rh = 0;  // on-screen rect in room coordinates
+		bool mirror = false;
+		bool missing = false;  // drawn, but there is no HD image for this cel
+		bool raw = false;      // codes drawn as palette indices (see noteCel())
+		bool precise = false;  // marks captured at actual decoder writes
+		int shadowMode = 0;    // original palette mask, not a painted object
+		uint32 seq = 0;
+		// Soft cels (see drawSoftCels())
+		bool soft = false;     // the image is soft and the cel was drawn on the screen
+		int zbuf = 0;          // z-plane mask of the actor
+		uint32 live = 0;       // screen pixels that show this drawing of the cel now
+		uint32 trueSum[3] = { 0, 0, 0 };  // colours of the image's palette over the drawn pixels
+		Common::Array<uint32> hist;       // per palette index: drawn pixels that show it
+		uint32 gainPal = 0;               // _palVersion of gain
+		int gain[3] = { 256, 256, 256 };  // shown colour / image colour, 256 = 1
+	};
+	enum { kCelSlotsPerActor = 32, kMaxCelSlots = 1024 };
+	// DIGHD_DEBUG_PIXEL=x0,y0,x1,y1[,frame]: how each screen pixel in the rectangle is composed
+	int _debugPixelX = -1, _debugPixelY = -1, _debugPixelX2 = -1, _debugPixelY2 = -1, _debugPixelFrom = 0;
+
+	// Which costume cel drew a pixel of the game screen buffer, and the value it
+	// wrote. A pixel shows the figure only while the cel's drawing is the last one
+	// of its slot (seq) and the pixel still holds the value (see markCel()).
+	struct CelMark {
+		uint32 seq;   // CelSlot::seq of the drawing, 0 = none
+		uint16 slot;  // index in _cels
+		byte val;     // palette index the cel left in the pixel
+		byte code;    // exact original image code when CelSlot::precise is true
+		bool paletteMask; // decoder actually applied a shadow-table lookup
+		byte pre;     // colour before this mask (or the first stacked mask)
+		uint32 underSeq; // original actor drawing underneath a palette mask
+		uint16 underSlot;
+		byte underCode;
+	};
+	struct CelLayer {
+		const byte *base = nullptr;  // the main virtual screen buffer
+		size_t size = 0;
