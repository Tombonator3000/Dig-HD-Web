+
+// Packed pixel source: top two bits say what kind, the rest are coordinates.
+// An original pixel is either kept on purpose (text, effects, banners) or
+// shown because no HD image exists for it (kSrcFlatMissing, marked yellow).
+// kSrcSan is the pixel at the same place in the current HD film frame.
+enum {
+	kSrcFlat        = 0u,
+	kSrcFlatMissing = 1u,
+	kSrcSan         = 2u,
+	kSrcRoom        = 1u << 30,
+	kSrcObject      = 2u << 30,
+	kSrcCel         = 3u << 30,
+	kSrcMask        = 3u << 30
+};
+
+// xBR 4x on a mask (see below)
+static void xbr4(const Common::Array<float> &mask, int w, int h, Common::Array<float> &out);
+
+static inline uint32 packRoom(int rx, int ry) { return kSrcRoom | ((uint32)ry << 15) | (uint32)rx; }
+static inline uint32 packObject(int slot, int ox, int oy) { return kSrcObject | ((uint32)slot << 22) | ((uint32)oy << 11) | (uint32)ox; }
+static inline uint32 packCel(int slot, int lx, int ly) { return kSrcCel | ((uint32)slot << 20) | ((uint32)ly << 10) | (uint32)lx; }
+
+// The z-plane masks are one bit per pixel, 8 pixels per byte, in rows of the
+// screen's strips (Gdi::getMaskBuffer(), and the renderer: a set bit hides the
+// actor's pixel). zOff is Gdi::_imgBufOffs of the plane, rx the room column.
+static inline bool zHidden(const byte *maskBase, int maskSize, int zOff, int strips, int rx, int vy, int vsh) {
+	if (rx < 0 || vy < 0 || vy >= vsh)
+		return true;
+	const int m = zOff + vy * strips + (rx >> 3);
+	return m >= 0 && m < maskSize && (maskBase[m] & (0x80 >> (rx & 7)));
+}
+
+// A cel pixel shown in a colour far from the costume's true colour is a
+// special effect (a shadow drawn through the shadow palette, another palette
+// mapping) and keeps the original pixel. Same test as for the other cels in
+// compose().
+static bool wildColour(const byte *truec, const byte *shown) {
+	for (int k = 0; k < 3; k++) {
+		const int t = truec[k], v = shown[k];
+		if (t < 16) {
+			if (v > 48)
+				return true;
+		} else {
+			const int f = v * 256 / t;
+			if (f > 512 || (t > 64 && f < 48))
+				return true;
+		}
+	}
+	return false;
+}
+
+// The nearest pixel with a colour in a cel's image around cx,cy (before the
+// mirror), within the rows and columns a scaled actor may drop. Sets code.
+bool DigHD::nearCode(const CelSlot &cs, int cx, int cy, byte &code) const {
+	const Graphics::Surface &ci = cs.image->idx;
+	const int rx = MIN(3, ci.w / MAX(1, cs.rw) + 1), ry = MIN(3, ci.h / MAX(1, cs.rh) + 1);
+	for (int d = 1; d <= MAX(rx, ry); d++) {
+		for (int dy = -MIN(d, ry); dy <= MIN(d, ry); dy++) {
+			for (int dx = -MIN(d, rx); dx <= MIN(d, rx); dx++) {
+				if (MAX(ABS(dx), ABS(dy)) != d)
+					continue;  // nearest ring first
+				int x = cx + dx;
+				const int y = cy + dy;
+				if (x < 0 || y < 0 || x >= ci.w || y >= ci.h)
+					continue;
+				if (cs.mirror)
+					x = ci.w - 1 - x;
+				const byte k = *((const byte *)ci.getBasePtr(x, y));
+				if ((int)k != cs.image->transparent) {
+					code = k;
+					return true;
+				}
+			}
+		}
+	}
+	return false;
+}
+
+// Whether a pixel a soft cel drew in colour idx at lx,ly of the drawn
+// rectangle is the cel's own art (and not a shadow or another effect). A
+// scaled actor drops rows and columns by the costume's scale table, not
+// evenly, so the pixel is compared with the codes around the point it maps
+// to in the original cel. Without that, the edges of scaled figures were
+// taken for effects and stayed original pixels around the HD figure.
+bool DigHD::softCelColour(const CelSlot &cs, int lx, int ly, byte idx) const {
+	const Graphics::Surface &ci = cs.image->idx;
+	int cx = CLIP(lx * ci.w / cs.rw, 0, ci.w - 1);
+	if (cs.mirror)
+		cx = ci.w - 1 - cx;
+	const int cy = CLIP(ly * ci.h / cs.rh, 0, ci.h - 1);
+	const int rx = MIN(3, ci.w / MAX(1, cs.rw) + 1), ry = MIN(3, ci.h / MAX(1, cs.rh) + 1);
+	for (int d = 0; d <= MAX(rx, ry); d++) {
+		for (int dy = -MIN(d, ry); dy <= MIN(d, ry); dy++) {
+			for (int dx = -MIN(d, rx); dx <= MIN(d, rx); dx++) {
+				if (MAX(ABS(dx), ABS(dy)) != d)
+					continue;  // nearest ring first
+				const int x = cx + dx, y = cy + dy;
+				if (x < 0 || y < 0 || x >= ci.w || y >= ci.h)
+					continue;
+				const byte code = *((const byte *)ci.getBasePtr(x, y));
+				if ((int)code == cs.image->transparent)
+					continue;
+				if (cs.raw ? code == idx : !wildColour(cs.image->basePal + code * 3, _pal + idx * 3))
+					return true;
+			}
+		}
+	}
+	return false;
+}
+
+static int envInt(const char *name, int def) {
+	const char *v = getenv(name);
+	return (v && *v) ? atoi(v) : def;
+}
+
+static bool confBool(const char *key) {
+	return ConfMan.hasKey(key) && ConfMan.getBool(key);
+}
