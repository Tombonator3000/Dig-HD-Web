+DigHD *DigHD::create(ScummEngine *vm) {
+	if (vm->_game.id != GID_DIG)
+		return nullptr;
+	Common::String mod = ConfMan.get("dighd_mod");
+	if (const char *env = getenv("DIGHD_MOD"))
+		mod = env;
+	if (mod.empty())
+		return nullptr;
+	return new DigHD(vm);
+}
+
+DigHD::DigHD(ScummEngine *vm) : _vm(vm) {
+	Common::String mod = ConfMan.get("dighd_mod");
+	if (const char *env = getenv("DIGHD_MOD"))
+		mod = env;
+	_modPath = Common::Path(mod, '/');
+	_scale = CLIP(envInt("DIGHD_SCALE", ConfMan.hasKey("dighd_scale") ? ConfMan.getInt("dighd_scale") : 4), 1, 8);
+	_rgba = Graphics::PixelFormat::createFormatRGBA32();
+	memset(_pal, 0, sizeof(_pal));
+	memset(_cycled, 0, sizeof(_cycled));
+
+	// Quadratic B-spline weights for the 3 original pixels around HD sub pixel d
+	// (left/centre/right, or above/centre/below). t is the sub pixel's distance
+	// from the centre of its original pixel, always inside (-0.5, 0.5).
+	memset(_cycleTap, 0, sizeof(_cycleTap));
+	for (int d = 0; d < _scale; d++) {
+		const float t = (d + 0.5f) / _scale - 0.5f;
+		_cycleTap[0][d] = (0.5f - t) * (0.5f - t) / 2;
+		_cycleTap[1][d] = 0.75f - t * t;
+		_cycleTap[2][d] = (0.5f + t) * (0.5f + t) / 2;
+	}
+
+	if (const char *d = getenv("DIGHD_DUMP_DIR"))
+		_dumpDir = Common::Path(d, '/');
+	_dumpEvery = envInt("DIGHD_DUMP_EVERY", 0);
+	_bench = envInt("DIGHD_BENCH", 0);
+	_testRoom = envInt("DIGHD_TEST_ROOM", -1);
+	_testAt = envInt("DIGHD_TEST_AT", 60);
+	_testCamX = envInt("DIGHD_TEST_CAMX", -1);
+	_testCamY = envInt("DIGHD_TEST_CAMY", -1);
+	_testCostume = envInt("DIGHD_TEST_COSTUME", -1);
+	_testActor = envInt("DIGHD_TEST_ACTOR", 29);
+	_testChoreEvery = MAX(1, envInt("DIGHD_TEST_CHORE_EVERY", 60));
+	_testPalette = envInt("DIGHD_TEST_PALETTE", -1);
+	if (const char *pos = getenv("DIGHD_TEST_POS"))
+		sscanf(pos, "%d,%d", &_testPosX, &_testPosY);
+	_testClip = envInt("DIGHD_TEST_CLIP", 0);
+	_debugSoft = envInt("DIGHD_DEBUG_SOFT", 0) != 0;
+	if (const char *walk = getenv("DIGHD_TEST_WALK"))
+		sscanf(walk, "%d,%d", &_testWalkX, &_testWalkY);
+	// DIGHD_TEST_OBJSTATE=884:2,886:1 puts these objects in these states after
+	// the test jump; DIGHD_TEST_OBJSTATE=alle shows every state of every object
+	// in the room, one after the other (see testObjectStates())
+	if (const char *os = getenv("DIGHD_TEST_OBJSTATE")) {
+		Common::String list(os);
+		list.toLowercase();
+		if (list == "alle" || list == "all") {
+			_testObjAll = true;
+		} else {
+			Common::StringTokenizer tok(list, ", ");
+			while (!tok.empty()) {
+				const Common::String item = tok.nextToken();
+				const size_t colon = item.findFirstOf(':');
+				TestObjStep s = { 0, -1 };
+				if (colon != Common::String::npos && colon > 0) {
+					s.obj = atoi(item.substr(0, colon).c_str());
+					s.state = atoi(item.substr(colon + 1).c_str());
+				}
+				if (s.obj > 0 && s.state >= 0 && s.state <= 255)
+					_testObjSteps.push_back(s);
+				else
+					warning("DigHD: DIGHD_TEST_OBJSTATE: '%s' is not object:state", item.c_str());
+			}
+		}
+	}
+	_testObjAt = MAX(0, envInt("DIGHD_TEST_OBJSTATE_AT", 30));
+	_testObjEvery = MAX(2, envInt("DIGHD_TEST_OBJSTATE_EVERY", 40));
+	_quitAt = envInt("DIGHD_QUIT_AT", -1);
+	_skipVideo = envInt("DIGHD_SKIP_VIDEO", 0) != 0;
+	_verify = envInt("DIGHD_VERIFY", 0) != 0;
+	_classic = envInt("DIGHD_CLASSIC", confBool("dighd_classic")) != 0;
+	_showMissing = envInt("DIGHD_SHOW_MISSING", confBool("dighd_show_missing")) != 0;
+	_dumpFlat = envInt("DIGHD_DUMP_FLAT", 0) != 0;
+
+	// How glyphs are made: font (standard: the HD typeface where the mod has
+	// one, else xbr), xbr, scale4x, nearest (for tests: the HD text is then the
+	// original text), or off (text as original pixels)
+	Common::String textScaler = ConfMan.get("dighd_text");
+	if (const char *env = getenv("DIGHD_TEXT"))
+		textScaler = env;
+	textScaler.toLowercase();
+	_textFace = textScaler.empty() || textScaler == "font";
+	if (textScaler == "off" || textScaler == "0")
+		_textScaler = kTextOff;
+	else if (textScaler == "nearest")
+		_textScaler = kTextNearest;
+	else if (textScaler == "scale4x" || textScaler == "epx")
+		_textScaler = kTextScale4x;
+	else
+		_textScaler = kTextXbr;
+	_glyphStyles.push_back(GlyphStyle());  // style 0 means no glyph
+
+	// DIGHD_TEST_KEYS=400:ctrl+h,500:ctrl+shift+h presses keys at the given
+	// frames, so the hotkeys can be tested without a keyboard. Keys: a to z,
+	// 0 to 9, f1 to f12, space and escape.
+	if (const char *keys = getenv("DIGHD_TEST_KEYS")) {
+		Common::String all(keys);
+		all.toLowercase();
+		Common::StringTokenizer tok(all, ", ");
+		while (!tok.empty()) {
+			const Common::String item = tok.nextToken();
+			const size_t colon = item.findFirstOf(':');
+			if (colon == Common::String::npos || colon == 0)
+				continue;
+			const Common::String combo = item.substr(colon + 1);
+			const size_t plus = combo.findLastOf('+');
+			const Common::String name = plus == Common::String::npos ? combo : combo.substr(plus + 1);
+			TestKey k;
+			k.frame = atoi(item.substr(0, colon).c_str());
+			if (name.size() == 1 && name[0] >= 'a' && name[0] <= 'z') {
+				k.keycode = (Common::KeyCode)(Common::KEYCODE_a + (name[0] - 'a'));
+				k.ascii = name[0];
+			} else if (name.size() == 1 && name[0] >= '0' && name[0] <= '9') {
+				k.keycode = (Common::KeyCode)(Common::KEYCODE_0 + (name[0] - '0'));
+				k.ascii = name[0];
+			} else if (name.size() >= 2 && name[0] == 'f' && atoi(name.c_str() + 1) >= 1 && atoi(name.c_str() + 1) <= 12) {
+				k.keycode = (Common::KeyCode)(Common::KEYCODE_F1 + atoi(name.c_str() + 1) - 1);
+				k.ascii = Common::ASCII_F1 + atoi(name.c_str() + 1) - 1;
+			} else if (name == "space") {
+				k.keycode = Common::KEYCODE_SPACE;
+				k.ascii = ' ';
+			} else if (name == "escape" || name == "esc") {
+				k.keycode = Common::KEYCODE_ESCAPE;
+				k.ascii = Common::ASCII_ESCAPE;
+			} else {
+				continue;
+			}
+			k.flags = (combo.contains("ctrl+") ? Common::KBD_CTRL : 0) |
+			          (combo.contains("shift+") ? Common::KBD_SHIFT : 0) |
+			          (combo.contains("alt+") ? Common::KBD_ALT : 0);
+			_testKeys.push_back(k);
+		}
+	}
+
+	// DIGHD_TEST_CLICKS=600:115/140,700:200/90 clicks the left mouse button at
+	// x/y (original pixels) at the given frames: the button goes down at the
+	// frame and up 3 frames later. For the game's own menus without a mouse.
+	if (const char *clicks = getenv("DIGHD_TEST_CLICKS")) {
+		Common::StringTokenizer tok(clicks, ", ");
+		while (!tok.empty()) {
+			const Common::String item = tok.nextToken();
+			TestClick c;
+			if (sscanf(item.c_str(), "%d:%d/%d", &c.frame, &c.x, &c.y) == 3)
+				_testClicks.push_back(c);
+		}
+	}
+
+	static const char *const textNames[] = { "off", "nearest", "scale4x", "xbr" };
+	debug("DigHD: mod '%s', scale %d, text %s%s%s", _modPath.toString().c_str(), _scale, textNames[_textScaler],
+	      _classic ? ", classic graphics" : "", _showMissing ? ", missing HD in yellow" : "");
+}
+
+DigHD::~DigHD() {
+	clearRoom();
+	_smushFrame.free();
+}
