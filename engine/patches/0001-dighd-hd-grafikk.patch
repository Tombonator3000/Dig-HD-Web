+	};
+
+	struct CelSlot {
+		bool used = false;
+		int costume = 0, cel = 0;
+		Image *image = nullptr;
+		int rx = 0, ry = 0, rw = 0, rh = 0;  // on-screen rect in room coordinates
+		bool mirror = false;
+		bool missing = false;  // drawn, but there is no HD image for this cel
+		bool raw = false;      // codes drawn as palette indices (see noteCel())
+		uint32 seq = 0;
+		// Soft cels (see drawSoftCels())
+		bool soft = false;     // the image is soft and the cel was drawn on the screen
+		int zbuf = 0;          // z-plane mask of the actor
+		uint32 live = 0;       // screen pixels that show this drawing of the cel now
+		uint32 trueSum[3] = { 0, 0, 0 };  // colours of the image's palette over the drawn pixels
+		Common::Array<uint32> hist;       // per palette index: drawn pixels that show it
+		uint32 gainPal = 0;               // _palVersion of gain
