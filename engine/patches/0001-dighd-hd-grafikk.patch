+void CharsetRendererClassic::digHDNoteGlyph(const byte *buffer, int pitch, int x, int y, int surfaceH,
+                                            const byte *src, byte bpp, int width, int height) {
+	if (bpp < 1 || bpp > 8 || width <= 0 || height <= 0 || width > 63 || height > 63)
+		return;
+	byte values[63 * 63], map[256];
+	byte b = *src++, nb = 8;
+	for (int i = 0; i < width * height; i++) {
+		values[i] = (b >> (8 - bpp)) & 0xFF;
+		b <<= bpp;
+		nb -= bpp;
+		if (nb == 0) {
+			b = *src++;
+			nb = 8;
+		}
+	}
+	memset(map, 0, sizeof(map));
+	memcpy(map, _vm->_charsetColorMap, sizeof(_vm->_charsetColorMap));
+	DigHD::GlyphDraw g;
+	g.buffer = buffer;
+	g.pitch = pitch;
+	g.x = x;
+	g.y = y;
+	g.w = width;
+	g.h = height;
+	g.values = values;
+	g.transparent = 0;
+	g.map = map;
+	// drawBitsN() draws every column, and the rows inside the surface
+	g.x0 = 0;
+	g.x1 = width;
+	g.y0 = MAX(0, -y);
+	g.y1 = MIN(height, surfaceH - y);
+	g.font = _curId;
+	g.chr = _digHDChr;
+	if (g.y0 < g.y1)
+		_vm->_digHD->noteGlyph(g);
+}
