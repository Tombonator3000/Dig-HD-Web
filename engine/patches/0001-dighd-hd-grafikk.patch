+	};
+	enum { kCelSlotsPerActor = 32, kMaxCelSlots = 1024 };
+
+	// Which costume cel drew a pixel of the game screen buffer, and the value it
+	// wrote. A pixel shows the figure only while the cel's drawing is the last one
+	// of its slot (seq) and the pixel still holds the value (see markCel()).
+	struct CelMark {
+		uint32 seq;   // CelSlot::seq of the drawing, 0 = none
+		uint16 slot;  // index in _cels
+		byte val;     // palette index the cel left in the pixel
